shop_restock = Array[ExtResource("2_01t1h")]([SubResource("Resource_eomhv"), SubResource("Resource_01t1h"), SubResource("Resource_y2fy7")])
intro_text = Array[String](["\"You're back! Let's get to work.\"", "\"Starting today you will have to pay me for the parts.\"", "\"I have another pop bumper set for you.\"", "\"Those ones are actually connected and activate each other\"", "\"Pretty neat, huh!?\"", "\"Oh, you can also have some saucers.\"", "\"They suck in the ball and then release it again.\"", "\"If you're unhappy with the placement...\"", "\"You can right click parts to sell them.\"", "\"I will give you half the price back.\"", "\"The rest I keep for my troubles, he he.\"", "\"Best be careful not to misplace them!\"", "\"Well, off you go.\""])
metadata/_custom_type_script = "uid://ba2t4smqoivon"
