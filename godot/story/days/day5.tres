intro_text = Array[String](["\"Heya!\"", "\"Didn't get to talk to you yesterday...\"", "\"Hope you're doing well! How is the machine?\"", "\"Tomorrow the weekend starts.\"", "\"Hope you're happy with your machine so far.\"", "\"Now: I want you to prove your machine.\"", "\"Make people happy. Earn coins.\"", "\"If you have 500 by the end of the week I will consider this a success!\"", "\"You got it? You got it!\"", "\"Get to work and get me those 500 coins.\""])
