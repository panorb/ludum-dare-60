intro_text = Array[String](["\"Hi man!\"", "\"Today is the last day of our little experiment.\"", "\"500 coins by the end of the week? Remember?\"", "\"It was a real pleasure working with you.\"", "\"If I don't catch you on the way out later, goodbye!\"", "\"And best of luck!\""])
